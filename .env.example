# Copy this file to .env.local and fill it in.
# .env.local is git-ignored. Never commit it and never share it.
# Only run.sh reads it, and only for the lifetime of one command.

# Your API key. As written, the scripts call the Anthropic API, so this is an
# Anthropic key. For another provider, see "Using another provider" in README.md.
ANTHROPIC_API_KEY=REPLACE_ME

# The model id to use, exactly as your provider's docs list it.
MODEL=REPLACE_ME

# Optional: your model's price in USD per 1 million tokens, from your provider's
# pricing page. When both are set, every run prints its cost.
#PRICE_INPUT_PER_MTOK=0.00
#PRICE_OUTPUT_PER_MTOK=0.00

# Only needed if every request fails with "anthropic-workspace-id is required".
# That happens with identity-linked keys. Copy the "wrkspc_..." id from the
# Workspaces page of your Anthropic console and uncomment the line below.
# Keep the double quotes, because the value contains a colon and a space.
#ANTHROPIC_CUSTOM_HEADERS="anthropic-workspace-id: wrkspc_REPLACE_ME"
